# Testbed config (loaded by tests/run_all.sh).
# Topology: two namespaces joined by a veth pair. The scheduler + target pump
# live in the target namespace; the peer pump in the peer namespace.
TARGET_NS=st_target
PEER_NS=st_peer
VETH_T=stvt0
VETH_P=stvp0
TARGET_IP=10.90.0.1
PEER_IP=10.90.0.2
PREFIX=24

# cgroup the scheduler hooks into (created by the runner)
CG=sotest

# Traffic / timing defaults
DURATION=15
PCKTSIZE=1400
UDP_PORT=9001
UDP_WORKERS=1
SCHEDULER_WARMUP=6
PCTS="10 25 50 75 90"